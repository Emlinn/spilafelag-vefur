# /etc/spilafelag-vefur/env  (root:spilafelag-vefur, 640)
NODE_ENV=production
HOST=127.0.0.1
PORT=3200
# BASE_PATH=/sub-path   only if served under a sub-path (it was /heimasida during testing)
TRUST_PROXY=1
DB_PATH=/var/lib/spilafelag-vefur/vefur.db
# Membership is decided by the board dashboard (same server, port 3100).
# INNRI_LYKILL must be the same value in /etc/spilafelag/env. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
STJORNBORD_URL=http://127.0.0.1:3100
INNRI_LYKILL=
